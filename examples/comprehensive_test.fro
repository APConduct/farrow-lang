-- Comprehensive Test of Farrow Language Features
-- This file demonstrates all the major features we've implemented

-- ===========================================
-- BASIC LITERALS AND ARITHMETIC
-- ===========================================

-- Integer literals
answer := 42
negative := -10

-- String literals
greeting := "Hello, Farrow!"
empty_string := ""

-- Boolean literals
is_true := true
is_false := false

-- Arithmetic with proper precedence
math_result := 1 + 2 * 3 + 4    -- Should be 11
division := 10 / 2               -- Should be 5
modulo := 17 % 5                 -- Should be 2

-- ===========================================
-- LISTS AND CONS OPERATIONS
-- ===========================================

-- List literals
numbers := [1, 2, 3, 4, 5]
strings := ["hello", "world"]
empty_list := []

-- Cons operations
cons_example := 0 : [1, 2, 3]           -- [0, 1, 2, 3]
nested_cons := 1 : 2 : [3, 4]           -- [1, 2, 3, 4]

-- ===========================================
-- LAMBDA FUNCTIONS
-- ===========================================

-- Simple lambda functions
increment := x |-> x + 1
double := x |-> x * 2
square := x |-> x * x

-- Lambda with more complex body
add_and_square := x |-> (x + 1) * (x + 1)

-- Higher-order function
apply_twice := f |-> (x |-> f (f x))

-- ===========================================
-- FUNCTION APPLICATION
-- ===========================================

-- Basic function application
inc_five := increment 5              -- Should be 6
double_three := double 3             -- Should be 6
square_four := square 4              -- Should be 16

-- Higher-order function usage
double_increment := apply_twice increment
quad_result := double_increment 5    -- Should be 7 (5 + 1 + 1)

-- ===========================================
-- PIPE OPERATOR
-- ===========================================

-- Pipe for function composition
piped_result := 5 |> increment |> double   -- (5 + 1) * 2 = 12

-- Pipe with lambda
piped_lambda := 10 |> (x |-> x * 3)        -- 30

-- ===========================================
-- PATTERN MATCHING
-- ===========================================

-- Simple pattern matching on literals
match_number := case 42 of
  0 => "zero"
  42 => "the answer"
  _ => "something else"

-- Pattern matching on booleans
match_bool := case true of
  true => "it's true"
  false => "it's false"

-- List pattern matching
list_head := case [1, 2, 3] of
  [] => 0
  h : t => h

-- Complex list pattern matching
list_operation := case [1, 2, 3, 4] of
  [] => "empty"
  h : [] => "single element"
  h : t => "multiple elements"

-- ===========================================
-- RECURSIVE FUNCTIONS
-- ===========================================

-- Simple recursive function with μ
simple_rec := μf |-> (x |-> case x of
  0 => 1
  _ => x)

-- More complex recursive pattern (factorial-like)
factorial_base := μf |-> (n |-> case n of
  0 => 1
  1 => 1
  _ => n)

-- ===========================================
-- LET BINDINGS AND SCOPING
-- ===========================================

-- Simple let binding
let_example := let x := 10 in x + 5

-- Nested let bindings
nested_let := let x := 5 in
  let y := x * 2 in
    x + y

-- Let with function
let_with_func := let f := x |-> x * 2 in f 7

-- ===========================================
-- COMPARISON AND LOGICAL OPERATIONS
-- ===========================================

-- Comparison operators
greater := 10 > 5                    -- true
less_equal := 3 <= 3                 -- true
equality := 42 == 42                 -- true
inequality := 1 != 2                 -- true

-- Logical operators
logical_and := true && false         -- false
logical_or := true || false          -- true

-- ===========================================
-- BUILT-IN FUNCTIONS
-- ===========================================

-- List operations
list_length := length [1, 2, 3, 4]   -- 4
list_head := head [10, 20, 30]       -- 10
list_tail := tail [10, 20, 30]       -- [20, 30]

-- Math operations
absolute := abs (-15)                -- 15

-- Type predicates
is_integer := int? 42                -- true
is_string := string? "hello"         -- true

-- ===========================================
-- COMPLEX COMBINATIONS
-- ===========================================

-- Function returning function (currying)
make_adder := x |-> (y |-> x + y)
add_ten := make_adder 10
result_twenty := add_ten 10          -- 20

-- Pattern matching with functions
process_list := xs |-> case xs of
  [] => 0
  h : t => h + 1

-- Combining multiple features
complex_example :=
  let numbers := [1, 2, 3, 4] in
  let processor := x |-> x * 2 in
  case numbers of
    [] => 0
    h : t => processor h

